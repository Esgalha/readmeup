{
  "name": "readmeup",
  "version": "1.1.0",
  "description": "Browser extension that surfaces README files at the top of repository pages",
  "type": "module",
  "scripts": {
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "dev:chrome": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox",
    "zip": "node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "browser-extension",
    "github",
    "gitlab",
    "bitbucket",
    "readme"
  ],
  "author": "Esgalha",
  "license": "MIT",
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.1",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.8",
    "archiver": "^8.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.8"
  }
}
